# API
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/buildflow

# Signature des jetons de session — OBLIGATOIRE
# Sans cette variable, l'API refuse de démarrer (sauf NODE_ENV=development|test)
# et `docker compose up` s'arrête avec un message explicite.
# Générer une valeur : openssl rand -hex 32
JWT_SECRET=a-remplacer-par-openssl-rand-hex-32

# OIDC / MFA
OIDC_PROVIDER=https://auth.example.com
OIDC_ISSUER=https://auth.example.com/realms/buildflow
OIDC_AUDIENCE=buildflow-api
OIDC_JWKS_URI=https://auth.example.com/realms/buildflow/protocol/openid-connect/certs
OIDC_REQUIRE_MFA=true

# S3 WORM
S3_REGION=eu-west-3
S3_WORM_BUCKET=buildflow-worm-evidences

# Event bus
AMQP_URL=amqp://guest:guest@localhost:5672
AMQP_EXCHANGE=buildflow.events

# Audit
AUDIT_LOG_FILE=data/audit-log.jsonl

# Observabilite (optionnel)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Stockage S3 / MinIO
# S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# Web
API_BASE_URL=http://localhost:3000
# JWT_SECRET doit être généré avec : openssl rand -hex 32
# Ne jamais versionner la valeur réelle — ce fichier est public.
JWT_SECRET=a-remplacer-par-openssl-rand-hex-32

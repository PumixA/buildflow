{
  "name": "buildflow-mvp",
  "workspaces": [
    "apps/*",
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node services/api-gateway/src/main.ts",
    "start:prod": "node dist/services/api-gateway/src/main.js",
    "start:legacy": "node server.js",
    "lint": "eslint \"{src,apps,libs,services,test}/**/*.{ts,tsx}\" --ignore-pattern \"apps/web/next-env.d.ts\"",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "start:dev": "nodemon --watch services --watch src --watch libs --ext ts,json --exec \"ts-node services/api-gateway/src/main.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@nestjs/common": "^11.1.7",
    "@nestjs/core": "^11.1.7",
    "@nestjs/platform-express": "^11.1.7",
    "amqplib": "^0.10.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^4.18.0",
    "jose": "^6.1.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^29.0.0",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
